# Caddyfile - Caddy provides SSL certificate with Let's Encrypt
# Traefik proxies traffic to Caddy on ports 80 (HTTP) and 443 (HTTPS)
# Caddy automatically gets Let's Encrypt certificate for this domain

lgd-demo.duckdns.org {
    # Serve static files from /usr/share/caddy/html
    root * /usr/share/caddy/html
    
    # Enable file server
    file_server
    
    # Enable gzip compression
    encode gzip
    
    # Security headers
    header {
        # Security headers for demo
        -Server
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Cache static assets
        Cache-Control "public, max-age=31536000, immutable" {
            /css/*
            /js/*
            /img/*.svg
        }
        Cache-Control "public, max-age=2592000" {
            /img/*.webp
        }
    }
    
    # Health check endpoint
    handle /health {
        respond "OK" 200
    }
    
    # Try files, then 404
    try_files {path} /index.html
    
    # Log errors
    log {
        output stdout
        format console
    }
}

