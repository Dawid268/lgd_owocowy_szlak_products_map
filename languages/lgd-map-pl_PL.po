msgstr "Nie znaleziono punktów. Dodaj pierwszy punkt używając formularza po lewej stronie."

# Validation Messages
msgid "This field is required"
msgstr "To pole jest wymagane"

msgid "Please enter a valid email address"
msgstr "Proszę wprowadzić prawidłowy adres email"

msgid "Please enter a valid URL"
msgstr "Proszę wprowadzić prawidłowy URL"

msgid "Please enter a valid phone number"
msgstr "Proszę wprowadzić prawidłowy numer telefonu"

msgid "Please enter valid coordinates"
msgstr "Proszę wprowadzić prawidłowe współrzędne"

msgid "Latitude must be between -90 and 90"
msgstr "Szerokość geograficzna musi być między -90 a 90"

msgid "Longitude must be between -180 and 180"
msgstr "Długość geograficzna musi być między -180 a 180"

msgid "Name must be at least 3 characters long"
msgstr "Nazwa musi mieć co najmniej 3 znaki"

msgid "Name cannot exceed 100 characters"
msgstr "Nazwa nie może przekraczać 100 znaków"

msgid "Description cannot exceed 500 characters"
msgstr "Opis nie może przekraczać 500 znaków"

# Success/Error Messages
msgid "Saving..."
msgstr "Zapisywanie..."

msgid "Point saved successfully!"
msgstr "Punkt został pomyślnie zapisany!"

msgid "Point deleted successfully!"
msgstr "Punkt został pomyślnie usunięty!"

msgid "An error occurred"
msgstr "Wystąpił błąd"

msgid "Are you sure you want to delete this point?"
msgstr "Czy na pewno chcesz usunąć ten punkt?"

msgid "Please fix the validation errors before saving."
msgstr "Proszę naprawić błędy walidacji przed zapisaniem."

msgid "Failed to save point: %s"
msgstr "Nie udało się zapisać punktu: %s"

msgid "Failed to delete point: %s"
msgstr "Nie udało się usunąć punktu: %s"

